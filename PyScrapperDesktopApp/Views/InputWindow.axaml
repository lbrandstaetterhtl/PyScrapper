<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PyScrapperDesktopApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="PyScrapperDesktopApp.Views.InputWindow"
        x:DataType="vm:InputWindowViewModel"
        Icon="/Assets/PyScrapperLogo.ico"
        SizeToContent="WidthAndHeight"
        CanMaximize="False"
        CanResize="False"
        CanMinimize="False"
        WindowStartupLocation="CenterOwner"
        MaxHeight="400"
        Title="PyScrapperDesktopApp">
        
        <Grid RowDefinitions="Auto, Auto, Auto" Margin="10" Classes="RootGrid">
                <TextBlock Grid.Row="0" Text="{Binding Massage}" Classes="UILabel"/>
                
                <TextBox Grid.Row="1" Text="{Binding InputText, Mode=TwoWay}" Classes="UI"/>
                
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                     <Button Classes="primary" IsDefault="True" Content="OK" Command="{Binding OkCommand}"/>
                     <Button Classes="primary" Content="Cancel" Command="{Binding CancelCommand}"/>
                </StackPanel>
                
        </Grid>
        
</Window>