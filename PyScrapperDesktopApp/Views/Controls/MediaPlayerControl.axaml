<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
             xmlns:vm="clr-namespace:PyScrapperDesktopApp.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="70"
             x:Class="PyScrapperDesktopApp.Views.Controls.MediaPlayerControl"
             x:DataType="vm:MediaPlayerControlViewModel">

    <Grid RowDefinitions="Auto, *" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

        <!-- ── Top Bar — immer sichtbar ── -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto">
            <Button Grid.Column="0"
                    Command="{Binding ToggleCompactCommand}"
                    Content="{Binding ToggleIcon}"
                    Classes="Icon"
                    Padding="10,2"
                    ToolTip.Tip="Expand / Collapse"/>
        </Grid>

        <!-- ══════════════════════════════════════════════ -->
        <!-- KOMPAKT VIEW                                   -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Classes="Cell" Grid.Row="1" IsVisible="{Binding IsCompact}" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto, Auto, Auto"
                  Margin="15,0">
                
                <ContentControl x:Name="VideoViewCompactHost"
                                Width="0" Height="0"
                                IsVisible="False"/>

                <TextBlock Grid.Column="0"
                           Text="{Binding NowPlayingTitle}"
                           Classes="UILabel"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentlyText}"
                           Classes="UILabel"
                           VerticalAlignment="Center"
                           Margin="10,0"/>

                <Button Grid.Column="2"
                        x:Name="CompactPreviousButton"
                        Command="{Binding PlayPreviousCommand}"
                        Classes="Icon"
                        IsVisible="{Binding IsPlaylistMode}"
                        IsEnabled="{Binding HasPrevious}"/>

                <Button Grid.Column="3"
                        x:Name="CompactPlayButton"
                        Classes="Icon"/>

                <Button Grid.Column="4"
                        x:Name="CompactNextButton"
                        Command="{Binding PlayNextCommand}"
                        Classes="Icon"
                        IsVisible="{Binding IsPlaylistMode}"
                        IsEnabled="{Binding HasNext}"/>

                <TextBlock Grid.Column="5"
                           Text="{Binding DurationText}"
                           Classes="UILabel"
                           VerticalAlignment="Center"
                           Margin="10,0"/>

                <Slider Grid.Column="6"
                        x:Name="CompactSeekSlider"
                        Minimum="0"
                        Maximum="{Binding DurationSeconds}"
                        Value="{Binding PositionSeconds, Mode=TwoWay}"
                        Classes="MediaPlayer"
                        Width="150"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════ -->
        <!-- NORMAL VIEW (nicht kompakt, nicht fullscreen)  -->
        <!-- ══════════════════════════════════════════════ -->
        <Border Classes="Cell" Grid.Row="1"
                IsVisible="{Binding IsNormalView}" HorizontalAlignment="Stretch">
            <Grid RowDefinitions="*, Auto, Auto, Auto">

                <Grid Grid.Row="0" RowDefinitions="Auto, *" Margin="15,0">
                    <TextBlock Grid.Row="0"
                               Text="{Binding NowPlayingTitle}"
                               Classes="UILabel"
                               Margin="0,5"/>
                    <ContentControl Grid.Row="1"
                                    x:Name="VideoViewHost"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    MinHeight="150"
                                    MinWidth="300"
                                    MaxWidth="600"
                                    IsVisible="{Binding HasVideo}"
                                    Margin="0,5"/>
                </Grid>

                <StackPanel Grid.Row="1" Classes="UICell" Margin="15,5">
                    <Image x:Name="SongIcon" Classes="Icon"/>
                    <Slider x:Name="SeekSlider"
                            Minimum="0"
                            Maximum="{Binding DurationSeconds}"
                            Value="{Binding PositionSeconds, Mode=OneWay}"
                            Classes="MediaPlayer"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Classes="UICell" Margin="15,5">
                    <TextBlock Text="{Binding CurrentlyText}" Classes="UILabel"/>
                    <Button x:Name="PreviousButton"
                            Command="{Binding PlayPreviousCommand}"
                            IsEnabled="{Binding HasPrevious}"
                            IsVisible="{Binding IsPlaylistMode}"
                            Classes="Icon"/>
                    <Button x:Name="PlayButton" Classes="Icon"/>
                    <Button x:Name="NextButton"
                            Command="{Binding PlayNextCommand}"
                            IsVisible="{Binding IsPlaylistMode}"
                            IsEnabled="{Binding HasNext}"
                            Classes="Icon"/>
                    <CheckBox x:Name="ShuffleCheckbox"
                              IsChecked="{Binding IsShuffleEnabled}"
                              IsVisible="{Binding IsPlaylistMode}"
                              Classes="Icon"/>
                    <TextBlock Text="{Binding DurationText}" Classes="UILabel"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Classes="UICell" Margin="15,5" Orientation="Horizontal">
                    <Image x:Name="VolumeIcon" Classes="Icon"/>
                    <Slider x:Name="VolumeSlider"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding Volume, Mode=TwoWay}"
                            VerticalAlignment="Center"
                            Classes="MediaPlayer"/>
                    <Button Content="+" Command="{Binding IncreaseVolumeCommand}" Classes="primary"/>
                    <Button Content="-" Command="{Binding DecreaseVolumeCommand}" Classes="primary"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</UserControl>
