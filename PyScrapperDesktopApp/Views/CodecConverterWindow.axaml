<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PyScrapperDesktopApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="PyScrapperDesktopApp.Views.CodecConverterWindow"
        x:DataType="vm:CodecConverterWindowViewModel"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/PyScrapperLogo.ico"
        Title="PyScrapperDesktopApp">
        
        <Grid RowDefinitions="Auto, Auto, Auto">
            <StackPanel Grid.Row="0" Classes="UICell">
                <TextBlock Text="{Binding InputFilePath}" Classes="UILabel"/>
                <TextBlock Text="{Binding StatusMessage}" Classes="UILabel"/>
                <TextBlock Text="{Binding OutputFilePath}" IsVisible="{Binding Started}" Classes="UILabel"/>
            </StackPanel>
            
            <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Height="24"/>
            
            <StackPanel Grid.Row="2" HorizontalAlignment="Right" Spacing="8" Classes="UICell">
                <Button Classes="primary" IsDefault="True" Content="Start Conversion" Command="{Binding StartConversionCommand}" IsEnabled="{Binding StartButtonEnabled}"/>
                <Button Classes="primary" Content="Cancel" Command="{Binding CancelConversionCommand}"/>
            </StackPanel>
        </Grid>
              
</Window>