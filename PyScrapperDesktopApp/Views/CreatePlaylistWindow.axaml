<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PyScrapperDesktopApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PyScrapperDesktopApp.Views.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="PyScrapperDesktopApp.Views.CreatePlaylistWindow"
        x:DataType="vm:CreatePlaylistWindowViewModel"
        SizeToContent="WidthAndHeight"
        MaxHeight="800"
        MaxWidth="1000"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1"
        Icon="/Assets/PyScrapperLogo.ico"
        Title="PyScrapperDesktopApp">
        
        <Grid RowDefinitions="35,*">
        
                <controls:TitleBarControl Grid.Row="0" x:Name="TitleBar" Background="{DynamicResource TitleBarGradient}"/>
        
        <Grid Grid.Row="1" RowDefinitions="Auto, Auto, Auto, *" Classes="RootGrid">
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Classes="UICell">
                        <TextBlock Text="Playlist Name: " HorizontalAlignment="Left" Classes="UILabel" MinWidth="213"/>
                        <TextBox Text="{Binding PlaylistName}" HorizontalAlignment="Right" Classes="UI"/>
                </StackPanel>
                
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Classes="UICell">
                        <TextBlock Text="Playlist description (optional): " HorizontalAlignment="Left" Classes="UILabel" MinWidth="150"/>
                        <TextBox Text="{Binding Description}" HorizontalAlignment="Right" Classes="UI"/>
                </StackPanel>
                
                <ScrollViewer Grid.Row="2"
                              MaxHeight="400"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              MaxWidth="600"
                              Margin="0,5">

                    <StackPanel Spacing="0"
                                HorizontalAlignment="Stretch">

                        <!-- Header -->
                        <Grid ColumnDefinitions="250,*,110"
                              ColumnSpacing="10"
                              Margin="5,5,5,10"
                              HorizontalAlignment="Stretch">

                            <TextBlock Grid.Column="0"
                                       Text="Title"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       Classes="UIValue"/>

                            <TextBlock Grid.Column="1"
                                       Text="Download Path"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       Classes="UIValue"/>

                            <TextBlock Grid.Column="2"
                                       Text="Playable"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold"
                                       Classes="UIValue"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding AvailableMedias}"
                                      HorizontalAlignment="Stretch">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="CellInteractive"
                                            IsTabStop="True"
                                            HorizontalAlignment="Stretch"
                                            Margin="5"
                                            MaxWidth="600"
                                            Tapped="MediaTapped">

                                        <Grid ColumnDefinitions="250,*,110"
                                              ColumnSpacing="10"
                                              HorizontalAlignment="Stretch">

                                            <!-- Titel -->
                                            <ScrollViewer Grid.Column="0"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Disabled">
                                                <TextBlock Text="{Binding Title}"
                                                           Classes="UIValue"
                                                           TextWrapping="NoWrap"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"/>
                                            </ScrollViewer>

                                            <!-- Download-Pfad -->
                                            <ScrollViewer Grid.Column="1"
                                                          HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Disabled">
                                                <TextBlock Text="{Binding DownloadPath}"
                                                           Classes="UIValue"
                                                           TextWrapping="NoWrap"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Left"/>
                                            </ScrollViewer>

                                            <!-- Abspielbar -->
                                            <CheckBox Grid.Column="2"
                                                      IsEnabled="False"
                                                      IsChecked="{Binding IsPlayable}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                
                <StackPanel Grid.Row="3" Classes="UICell">
                        <Button Classes="primary" IsDefault="True" Content="Create Playlist" Command="{Binding CreatePlaylistCommand}"/>
                        <Button Classes="primary" Content="Cancel" Command="{Binding CancelCommand}"/>
                </StackPanel>
        </Grid>
        </Grid>
</Window>