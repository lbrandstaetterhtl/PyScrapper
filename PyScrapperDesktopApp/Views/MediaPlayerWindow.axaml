<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonia="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
        xmlns:vm="clr-namespace:PyScrapperDesktopApp.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="PyScrapperDesktopApp.Views.MediaPlayerWindow"
        x:DataType="vm:MediaPlayerWindowViewModel"
        Icon="/Assets/PyScrapperLogo.ico"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        MaxHeight="400"
        Title="PyScrapperDesktopApp">
    
        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto">
                <StackPanel Grid.Row="0" Classes="UICell">
                        <TextBlock Text="{Binding NowPlayingTitle}" Classes="UILabel"/>
                        <avalonia:VideoView x:Name="VideoView" IsVisible="{Binding  HasVideo}" Height="200" Margin="10"/>
                </StackPanel>
                
                <Slider Name="SeekSlider" Grid.Row="1" Grid.ColumnSpan="3"
                        Minimum="0" Maximum="{Binding DurationSeconds}" 
                        Value="{Binding PositionSeconds, Mode=OneWay}"/>
                
                <StackPanel Grid.Row="2" Orientation="Horizontal" Classes="UICell">
                        <TextBlock Text="{Binding CurrentlyText}" Classes="UIValue"/>
                        <Button Content="Play" Command="{Binding PlayCommand}" Classes="primary"/>
                        <Button Content="Pause" Command="{Binding PauseCommand}" Classes="primary"/>
                        <Button Content="Stop" Command="{Binding StopCommand}" Classes="primary"/>
                        <CheckBox Content="Shuffle" IsChecked="{Binding IsShuffleEnabled}"/>
                        <TextBlock Text="{Binding DurationText}" Classes="UILabel"/>
                </StackPanel>
                
                
                <Slider Grid.Row="3" x:Name="VolumeSlider"
                        Minimum="0" Maximum="100"
                        Value="{Binding Volume, Mode=TwoWay}"
                        VerticalAlignment="Center"/>
                
                <StackPanel Grid.Row="4" Classes="UICell">
                        <Button Content="Increase Volume" Command="{Binding IncreaseVolumeCommand}" Classes="primary"/>
                        <Button Content="Decrease Volume" Command="{Binding DecreaseVolumeCommand}" Classes="primary"/>
                </StackPanel>
                
                <Button Grid.Row="5" Content="Close" x:Name="CloseButton"/>
        </Grid>
        
</Window>