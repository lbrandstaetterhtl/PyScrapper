<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PyScrapperDesktopApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="PyScrapperDesktopApp.Views.ProgressBarWindow"
        x:DataType="vm:ProgressBarWindowViewModel"
        Icon="/Assets/PyScrapperLogo.ico"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        CanResize="False"
        CanMaximize="False"
        CanMinimize="False"
        SizeToContent="WidthAndHeight"
        Title="PyScrapperDesktopApp">
        
        <StackPanel Margin="20" Spacing="12">

                <TextBlock Text="{Binding Status}" Classes="UILabel"/>

                <TextBlock Text="{Binding Progress, StringFormat={}{0}%}" Classes="UIValue"/>
                
                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding Progress}"
                             Height="24"/>
                
                <Button IsDefault="True" Content="Close" Command="{Binding CloseCommand}"/>
        </StackPanel>
        
</Window>