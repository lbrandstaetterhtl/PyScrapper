<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PyScrapperDesktopApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PyScrapperDesktopApp.Views.Controls"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="500"
        x:Class="PyScrapperDesktopApp.Views.PlaylistDetailsWindow"
        x:DataType="vm:PlaylistDetailsWindowViewModel"
        MinWidth="400"
        MaxWidth="560"
        MinHeight="300"
        MaxHeight="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/PyScrapperLogo.ico"
        Title="PyScrapperDesktopApp"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Grid RowDefinitions="35,*" Classes="RootGrid">

        <controls:TitleBarControl Grid.Row="0" x:Name="TitleBar" Background="{DynamicResource TitleBarGradient}"/>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto" Margin="14,10,14,14">

            <Border Grid.Row="0" Classes="Cell" HorizontalAlignment="Stretch" Margin="0,0,0,0">
                <Grid ColumnDefinitions="*,Auto,*">
                    <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="Playlist" Classes="UILabel" Margin="0" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PlaylistName}" Classes="UIValue" FontSize="15" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border Grid.Column="1" Classes="SeperatorVertical" Margin="8,4"/>

                    <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="Description" Classes="UILabel" Margin="0" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Description}" Classes="UIValue" FontSize="15" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Classes="SeparatorHorizontal" HorizontalAlignment="Stretch" Margin="4,6"/>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Button x:Name="AddButton" Classes="primary" Content="Add Media" Click="AddMediaClick"></Button>
                    
                    <ItemsControl x:Name="MediasInPlaylist" ItemsSource="{Binding Medias}" IsVisible="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="CellInteractive"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,3"
                                        DoubleTapped="DoubleClickMedia">

                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Play" Click="PlayButtonClick"/>
                                            <MenuItem Header="Remove from Playlist" Click="RemoveButtonClick"/>
                                        </MenuFlyout>
                                    </Border.ContextFlyout>

                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                        <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2">
                                            <TextBlock Text="{Binding Title}"
                                                       Classes="UIValue"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Left"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding MediaType}"
                                                       Classes="UIValue"
                                                       FontSize="12"
                                                       HorizontalAlignment="Left"
                                                       Opacity="0.6"/>
                                        </StackPanel>

                                        <CheckBox Grid.Column="1"
                                                  Content="Playable"
                                                  IsChecked="{Binding IsPlayable}"
                                                  Classes="IsPlayable"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <StackPanel x:Name="Search" Orientation="Horizontal" HorizontalAlignment="Stretch" IsVisible="False">
                        <TextBlock Text="Search for a media: " Classes="UILabel"/>
                        <TextBox x:Name="SearchQueryBox" HorizontalAlignment="Center" Text="{Binding SearchQuery}" Classes="UI" Width="200"/>
                        <Button Content="Search" Classes="primary" Command="{Binding SearchCommand}"/>
                        <Button Content="Back" Classes="primary" Click="CloseSearchClick"/>
                    </StackPanel>
                    
                        <ItemsControl x:Name="SearchedMedias" ItemsSource="{Binding SearchedMedias}" IsVisible="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="CellInteractive"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,3"
                                            DoubleTapped="DoubleClickSearchedMedia">

                                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                            <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2">
                                                <TextBlock Text="{Binding Title}"
                                                           Classes="UIValue"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Left"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding MediaType}"
                                                           Classes="UIValue"
                                                           FontSize="12"
                                                           HorizontalAlignment="Left"
                                                           Opacity="0.6"/>
                                            </StackPanel>

                                            <CheckBox Grid.Column="1"
                                                      Content="Playable"
                                                      IsChecked="{Binding IsPlayable}"
                                                      Classes="IsPlayable"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" Classes="SeparatorHorizontal" HorizontalAlignment="Stretch" Margin="4,8,4,20"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                        Spacing="8" Margin="0,36,0,0">
                <Button Classes="primary" Content="Play Playlist" Command="{Binding PlayPlaylistCommand}"/>
                <Button Classes="primary" Content="Close" Command="{Binding CloseCommand}"/>
            </StackPanel>

        </Grid>
    </Grid>
</Window>
