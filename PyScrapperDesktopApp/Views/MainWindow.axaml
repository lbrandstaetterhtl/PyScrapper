<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PyScrapperDesktopApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:PyScrapperDesktopApp.Models"
        xmlns:controls="clr-namespace:PyScrapperDesktopApp.Views.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="PyScrapperDesktopApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        WindowState="Maximized"
        Icon="/Assets/PyScrapperLogo.ico"
        Title="PyScrapperDesktopApp"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="35,*">
        
        <controls:TitleBarControl Grid.Row="0" x:Name="TitleBar" Background="{DynamicResource TitleBarGradient}"/>
    
    <Grid Grid.Row="1" Classes="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid.ColumnDefinitions>*</Grid.ColumnDefinitions>
        
        <Menu Grid.Row="0" Margin="5,0">
            <MenuItem Header="Sort">
                <MenuItem Header="By Title" Command="{Binding SortByNameCommand}"/>
                <MenuItem Header="By Date" Command="{Binding SortByDateCommand}"/>
                <MenuItem Header="By ID" Command="{Binding SortByIdCommand}"/>
            </MenuItem>
            <MenuItem Header="Scrap">
                <MenuItem Header="From Suno" Command="{Binding OpenSunoScrapWindowCommand}"/>
                <MenuItem Header="From Youtube" Command="{Binding OpenYoutubeScrapWindowCommand}"/>
                <MenuItem Header="From Bandcamp" Command="{Binding OpenBandcampScrapWindowCommand}"/>
            </MenuItem>
            <MenuItem Header="Open Media Player" Command="{Binding OpenMediaPlayerWindowCommand}"/>
            <MenuItem Header="Playlists">
                <MenuItem Header="Create Playlist" Command="{Binding CreatePlaylistCommand}"/>
                <MenuItem Header="Show Playlists" Click="ShowPlaylistsClick"/>
                <MenuItem Header="Delete All Playlists" Command="{Binding DeleteAllPlaylistsCommand}"/>
            </MenuItem>
            <MenuItem Header="Medias">
                <MenuItem Header="Convert Video Codec" Command="{Binding ConvertCodecCommand}"/>
                <MenuItem Header="Scan A Folder For Medias" Command="{Binding ScanFolderCommand}"/>
                <MenuItem Header="Delete All Medias" Command="{Binding DeleteAllMediasCommand}"/>
            </MenuItem>
            <MenuItem Header="Server">
                <MenuItem Header="Get Health" Command="{Binding GetHealthCommand}"/>
            </MenuItem>
            <MenuItem Header="Logs">
                <MenuItem Header="App Logs" Command="{Binding ShowAppLogsCommand}"/>
                <MenuItem Header="Server Logs" Command="{Binding ShowServerLogsCommand}"/>
            </MenuItem>
            <MenuItem Header="Settings">
                <MenuItem Header="Default Downloads Path" Command="{Binding EditDownloadsPathCommand}"/>
                <MenuItem Header="Toggle Dark/Light Mode" Command="{Binding ToggleThemeCommand}"/>
            </MenuItem>
        </Menu>
        
        <ScrollViewer x:Name="DownloadedMediasList" Grid.Row="1" HorizontalScrollBarVisibility="Auto">
            <Grid RowDefinitions="Auto, Auto, *" ColumnDefinitions="1000">
            <Border Grid.Row="0" Classes="Cell" HorizontalAlignment="Left" Width="1000" MaxWidth="1000">
                <StackPanel Classes="UICell" Width="800" MaxWidth="800" HorizontalAlignment="Left">
                    <TextBlock Text="ID" Classes="UILabel" Width="70"/>
                    <TextBlock Text="Title" Classes="UILabel" Width="450"/>
                    <TextBlock Text="Type" Classes="UILabel" Width="70"/>
                    <TextBlock Text="Downloaded At" Classes="UILabel" Width="200"/>
                    <TextBlock Text="Is Playable" Classes="UILabel" Width="130"/>
                </StackPanel>
            </Border>
            
                <Border Grid.Row="1" Classes="Seperator" Width="1000"/>
            
            <ItemsControl Grid.Row="2" ItemsSource="{Binding DownloadedMediaList}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border DoubleTapped="MediaDoubleClick" Classes="CellInteractive" HorizontalAlignment="Left" Width="1000" MaxWidth="1000">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem Header="Add To Playlist">
                                        <ListBox ItemsSource="{x:Static models:AppData.Playlists}" 
                                                 SelectionMode="Single" 
                                                 SelectionChanged="AddToPlaylistClick">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="models:Playlist">
                                                    <TextBlock Text="{Binding Name}" Classes="UIValue"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </MenuItem>
                                    <MenuItem Header="Copy Download Path" Click="CopyDownloadPathClick"/>
                                    <MenuItem Header="Copy URL" Click="CopyUrlClick"/>
                                    <MenuItem Header="Delete File" Click="DeleteFile"/>
                                    <MenuItem Header="Delete Only The Media Item" Click="DeleteMedia"/>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            
                            <StackPanel Classes="UICell" Width="800" MaxWidth="800" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Id}" Classes="UILabel" HorizontalAlignment="Stretch" Width="70" MaxWidth="70"/>
                            <TextBlock Text="{Binding Title}" Classes="UILabel" HorizontalAlignment="Stretch" Width="450" MaxWidth="450"/>
                            <TextBlock Text="{Binding MediaType}" Classes="UILabel" HorizontalAlignment="Stretch" Width="70" MaxWidth="70"/>
                            <TextBlock Text="{Binding DownloadedAt}" Classes="UILabel" HorizontalAlignment="Stretch" Width="200" MaxWidth="200"/>
                            <CheckBox Content="Is Playable" IsChecked="{Binding IsPlayable}" Classes="IsPlayable" HorizontalAlignment="Stretch" Width="130" MaxWidth="130"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Grid>
        </ScrollViewer>
        
        <ScrollViewer Grid.Row="2" IsVisible="False" x:Name="PlaylistsList" HorizontalScrollBarVisibility="Auto">
            <StackPanel>
                <Button Content="Go back to medias list" Click="ShowDownloadedMediasClick" Classes="primary" HorizontalAlignment="Left"/>
            <ItemsControl ItemsSource="{Binding Playlists}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="CellInteractive" HorizontalAlignment="Left" DoubleTapped="PlaylistDoubleClick">
                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem Header="Delete Playlist" Click="DeletePlaylist"/>
                                    <MenuItem Header="Open Playlist Details" Click="OpenPlaylistDetailsClick"/>
                                </MenuFlyout>
                            </Border.ContextFlyout>
                            
                            <StackPanel Classes="UICell">
                                <TextBlock Text="{Binding Name}" Classes="UILabel"/>
                                <TextBlock Text="{Binding Description}" Classes="UILabel"/>
                                <TextBlock Text="{Binding Count}" Classes="UILabel"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </Grid>

</Window>
