<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style Selector="Button.primary">
        <Setter Property="Background"          Value="{DynamicResource SurfaceGradient}"/>
        <Setter Property="Foreground"          Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CornerRadius"        Value="8"/>
        <Setter Property="Padding"             Value="14,8"/>
        <Setter Property="Margin"              Value="5"/>
        <Setter Property="FontWeight"          Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style Selector="Button.Icon">
        <Setter Property="Background"          Value="Transparent"/>
        <Setter Property="BorderBrush"         Value="Transparent"/>
        <Setter Property="BorderThickness"     Value="0"/>
        <Setter Property="Padding"             Value="5"/>
        <Setter Property="Margin"              Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="MaxHeight" Value="30"/>
        <Setter Property="MaxWidth" Value="30"/>
    </Style>
    
    <Style Selector="CheckBox.Icon">
        <Setter Property="Background"          Value="Transparent"/>
        <Setter Property="BorderBrush"         Value="Transparent"/>
        <Setter Property="BorderThickness"     Value="0"/>
        <Setter Property="Padding"             Value="5"/>
        <Setter Property="Margin"              Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="MaxHeight" Value="30"/>
        <Setter Property="MaxWidth" Value="30"/>
    </Style>
    
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceGradientPointerOver}"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="TextBox.UI">
        <Setter Property="Margin"              Value="5"/>
        <Setter Property="MinWidth"            Value="200"/>
        <Setter Property="MaxWidth"            Value="600"/>
        <Setter Property="CornerRadius"        Value="8"/>
        <Setter Property="Background"          Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground"          Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    
    <Style Selector="TextBox.UI:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrushPointerOver}"/>
    </Style>
    
    <Style Selector="TextBox.UI:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrushPointerOver}"/>
    </Style>
    
    <Style Selector="ComboBox.UI">
        <Setter Property="Margin"              Value="8"/>
        <Setter Property="CornerRadius"        Value="8"/>
        <Setter Property="Background"          Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground"          Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    
    <Style Selector="ComboBox.UI:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrushPointerOver}"/>
    </Style>

    <Style Selector="StackPanel.UICell">
        <Setter Property="Margin"              Value="5"/>
        <Setter Property="Spacing"             Value="7"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Orientation"         Value="Horizontal"/>
    </Style>

    <Style Selector="Border.Seperator">
        <Setter Property="Background"          Value="{DynamicResource SeparatorBrush}"/>
        <Setter Property="Height"              Value="1"/>
        <Setter Property="Margin"              Value="10,5"/>
    </Style>

    <Style Selector="Border.CellInteractive">
        <Setter Property="Background"          Value="{DynamicResource SurfaceGradient}"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness"     Value="1"/>
        <Setter Property="Padding"             Value="10"/>
        <Setter Property="CornerRadius"        Value="8"/>
        <Setter Property="Margin"              Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style Selector="MenuItem">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    
    <Style Selector="Border.CellInteractive:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceGradientPointerOver}"/>
        <Setter Property="Opacity" Value="0.8"/>
    </Style>
    
    <Style Selector="Border.Cell">
        <Setter Property="Background"          Value="{DynamicResource SurfaceGradient}"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness"     Value="1"/>
        <Setter Property="Padding"             Value="10"/>
        <Setter Property="CornerRadius"        Value="8"/>
        <Setter Property="Margin"              Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.UILabel">
        <Setter Property="FontWeight"          Value="SemiBold"/>
        <Setter Property="FontSize"            Value="16"/>
        <Setter Property="Margin"              Value="5"/>
        <Setter Property="Foreground"          Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.UIValue">
        <Setter Property="Margin"              Value="5"/>
        <Setter Property="Foreground"          Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="ListBox.SelectableItem">
        <Setter Property="Margin"              Value="5"/>
        <Setter Property="Padding"             Value="5"/>
        <Setter Property="CornerRadius"        Value="8"/>
        <Setter Property="Background"          Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="CheckBox.IsPlayable">
        <Setter Property="Margin"                   Value="5"/>
        <Setter Property="HorizontalAlignment"      Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="IsEnabled"                Value="False"/>
    </Style>
    
    <Style Selector="ProgressBar:horizontal /template/ Border#ProgressBarTrack">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    
    <Style Selector="ProgressBar:horizontal /template/ Border#PART_Indicator">
        <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    
    <Style Selector="ProgressBar:horizontal /template/ Border#IndeterminateProgressBarIndicator">
        <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    
    <Style Selector="ProgressBar:horizontal /template/ Border#IndeterminateProgressBarIndicator2">
        <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    
    <Style Selector="Slider:horizontal /template/ Thumb#thumb /template/ Ellipse#SliderInnerThumb">
        <Setter Property="Fill" Value="{DynamicResource AccentGradient}"/>
    </Style>
    
    <Style Selector="Slider:horizontal /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="{DynamicResource SliderIncrease}"/>
    </Style>
    
    
    <Style Selector="Slider:horizontal /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource SliderDecrease}"/>
    </Style>
    
    <Style Selector="Slider">
        <Setter Property="Margin" Value="5"/>
    </Style>
    
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox.spinRight /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    </Style>
    
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox.spinRight /template/ TextPresenter#PART_TextPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    
    <Style Selector="Grid.RootGrid">
        <Setter Property="Background" Value="{DynamicResource BackgroundGradient}"/>
    </Style>
    
    <Style Selector="StackPanel.RootPanel">
        <Setter Property="Background" Value="{DynamicResource BackgroundGradient}"/>
    </Style>
    
    <Style Selector="ScrollViewer.RootScrollViewer">
        <Setter Property="Background" Value="{DynamicResource BackgroundGradient}"/>
    </Style>
    
    <Style Selector="Image.Icon">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="5"/>
    </Style>
    
    <Style Selector="Slider.MediaPlayer">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Width" Value="400"/>
    </Style>
    
    <Style Selector="Button.TitleBarBtn">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Width"           Value="46"/>
        <Setter Property="Height"          Value="32"/>
        <Setter Property="CornerRadius"    Value="0"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.TitleBarBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="rgba(255,255,255,0.1)"/>
    </Style>

    <Style Selector="Button.TitleBarClose:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#e81123"/>
    </Style>
        
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
            
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="BgPrimary">#0d1117</Color>
                    <Color x:Key="BgSecondary">#161b27</Color>
                    <Color x:Key="Surface">#1e2540</Color>
                    <Color x:Key="BorderColor">#3b4fa8</Color>
                    <Color x:Key="Accent">#3776d4</Color>
                    <Color x:Key="AccentLight">#5a9ef5</Color>
                    <Color x:Key="TextPrimary">#e8eaf0</Color>
                    <Color x:Key="TextSecondary">#7a8aaa</Color>
                    <Color x:Key="SeparatorMid">#3776d4</Color>
                    <Color x:Key="SliderIncrease">#a7dbef</Color>
                    <Color x:Key="SliderDecrease">#0b4db7</Color>
                    <Color x:Key="SurfacePointerOver">#2e323e</Color>

                    <SolidColorBrush x:Key="BgPrimaryBrush"    Color="{StaticResource BgPrimary}"/>
                    <SolidColorBrush x:Key="SurfaceBrush"      Color="{StaticResource Surface}"/>
                    <SolidColorBrush x:Key="BorderBrush"       Color="{StaticResource BorderColor}"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush"  Color="{StaticResource TextPrimary}"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
                    <SolidColorBrush x:Key="SliderIncreaseBrush" Color="{StaticResource SliderIncrease}"/>
                    <SolidColorBrush x:Key="SliderDecreaseBrush" Color="{StaticResource SliderDecrease}"/>
                    <SolidColorBrush x:Key="SurfaceBrushPointerOver" Color="{StaticResource SurfacePointerOver}"/>

                    <LinearGradientBrush x:Key="AccentGradient"
                                         StartPoint="0%,0%"
                                         EndPoint="100%,100%">
                        <GradientStop Color="#2061c3" Offset="0.15"/>
                        <GradientStop Color="#0f3261" Offset="0.75"/>
                    </LinearGradientBrush>

                    <LinearGradientBrush x:Key="SurfaceGradient"
                                         StartPoint="50%,0%"
                                         EndPoint="50%,100%">
                        <GradientStop Color="#1f4b8d" Offset="0.15"/>
                        <GradientStop Color="#031c3c" Offset="0.75"/>
                    </LinearGradientBrush>
                    
                    <LinearGradientBrush x:Key="SurfaceGradientPointerOver" 
                                         StartPoint="50%,0%"
                                         EndPoint="50%,100%">
                        <GradientStop Color="#49658e" Offset="0"/>
                        <GradientStop Color="#223144" Offset="1"/>
                    </LinearGradientBrush>
                    
                    <LinearGradientBrush x:Key="SeparatorBrush"
                                         StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#253060"     Offset="0.3"/>
                        <GradientStop Color="#3776d4"     Offset="0.5"/>
                        <GradientStop Color="#253060"     Offset="0.7"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                    
                    <LinearGradientBrush x:Key="BackgroundGradient"
                                         StartPoint="100%,0%"
                                         EndPoint="0%,100%">
                        <GradientStop Color="#03061c" Offset="0.3"/>
                        <GradientStop Color="#0a294c" Offset="0.7"/>
                    </LinearGradientBrush>
                    
                    <LinearGradientBrush x:Key="TitleBarGradient"
                                         StartPoint="100%,0%"
                                         EndPoint="0%,100%">
                        <GradientStop Color="#0a294c" Offset="0.3"/>
                        <GradientStop Color="#03061c" Offset="0.7"/>
                    </LinearGradientBrush>
                </ResourceDictionary>
                
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="BgPrimary">#fafaf8</Color>
                    <Color x:Key="BgSecondary">#f0f0e8</Color>
                    <Color x:Key="Surface">#6acef9</Color>
                    <Color x:Key="BorderColor">#63e1db</Color>
                    <Color x:Key="Accent">#2588b2</Color>
                    <Color x:Key="AccentLight">#4792b3</Color>
                    <Color x:Key="TextPrimary">#1a1a2a</Color>
                    <Color x:Key="TextSecondary">#5a5a6a</Color>
                    <Color x:Key="SeparatorMid">#22c8c0</Color>
                    <Color x:Key="SliderIncrease">#87dadc</Color>
                    <Color x:Key="SliderDecrease">#0dd2c8</Color>
                    <Color x:Key="SurfacePointerOver">#6ecaf1</Color>

                    <SolidColorBrush x:Key="BgPrimaryBrush"    Color="{StaticResource BgPrimary}"/>
                    <SolidColorBrush x:Key="SurfaceBrush"      Color="{StaticResource Surface}"/>
                    <SolidColorBrush x:Key="BorderBrush"       Color="{StaticResource BorderColor}"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush"  Color="{StaticResource TextPrimary}"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
                    <SolidColorBrush x:Key="SliderIncreaseBrush" Color="{StaticResource SliderIncrease}"/>
                    <SolidColorBrush x:Key="SliderDecreaseBrush" Color="{StaticResource SliderDecrease}"/>
                    <SolidColorBrush x:Key="SurfaceBrushPointerOver" Color="{StaticResource SurfacePointerOver}"/>

                    <LinearGradientBrush x:Key="AccentGradient"
                                         StartPoint="0%,0%"
                                         EndPoint="100%,100%">
                        <GradientStop Color="#1989b8" Offset="0.15"/>
                        <GradientStop Color="#0e597a" Offset="0.75"/>
                    </LinearGradientBrush>

                    <LinearGradientBrush x:Key="SurfaceGradient"
                                         StartPoint="50%,0%"
                                         EndPoint="50%,100%">
                        <GradientStop Color="#2d7ead" Offset="0.15"/>
                        <GradientStop Color="#135981" Offset="0.75"/>
                    </LinearGradientBrush>
                    
                    <LinearGradientBrush x:Key="SurfaceGradientPointerOver"  
                                         StartPoint="50%,0%"
                                         EndPoint="50%,100%">
                        <GradientStop Color="#a6dfe0" Offset="0.15"/>
                        <GradientStop Color="#5a8caa" Offset="0.75"/>
                    </LinearGradientBrush>

                    <LinearGradientBrush x:Key="SeparatorBrush"
                                         StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#87dadc"     Offset="0.3"/>
                        <GradientStop Color="#219d97"     Offset="0.5"/>
                        <GradientStop Color="#87dadc"     Offset="0.7"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                    
                    <LinearGradientBrush x:Key="BackgroundGradient"
                                         StartPoint="100%,0%"
                                         EndPoint="0%,100%">
                        <GradientStop Color="#87dadc" Offset="0.3"/>
                        <GradientStop Color="#0dd2c8" Offset="0.7"/>
                    </LinearGradientBrush>
                    
                    <LinearGradientBrush x:Key="TitleBarGradient"
                                         StartPoint="100%,0%"
                                         EndPoint="0%,100%">
                        <GradientStop Color="#0dd2c8" Offset="0.3"/>
                        <GradientStop Color="#87dadc" Offset="0.7"/>
                    </LinearGradientBrush>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    
</Styles>