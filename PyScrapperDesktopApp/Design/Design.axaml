<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style Selector="Button.primary">
        <Setter Property="Background"          Value="{DynamicResource SurfaceGradient}"/>
        <Setter Property="Foreground"          Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CornerRadius"        Value="8"/>
        <Setter Property="Padding"             Value="14,8"/>
        <Setter Property="Margin"              Value="5"/>
        <Setter Property="FontWeight"          Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style Selector="Button.Icon">
        <Setter Property="Background"          Value="Transparent"/>
        <Setter Property="BorderBrush"         Value="Transparent"/>
        <Setter Property="BorderThickness"     Value="0"/>
        <Setter Property="Padding"             Value="5"/>
        <Setter Property="Margin"              Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="MaxHeight" Value="30"/>
        <Setter Property="MaxWidth" Value="30"/>
    </Style>
    
    <Style Selector="CheckBox.Icon">
        <Setter Property="Background"          Value="Transparent"/>
        <Setter Property="BorderBrush"         Value="Transparent"/>
        <Setter Property="BorderThickness"     Value="0"/>
        <Setter Property="Padding"             Value="5"/>
        <Setter Property="Margin"              Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="MaxHeight" Value="30"/>
        <Setter Property="MaxWidth" Value="30"/>
    </Style>
    
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceGradientPointerOver}"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style Selector="TextBox.UI">
        <Setter Property="Margin"              Value="5"/>
        <Setter Property="MinWidth"            Value="200"/>
        <Setter Property="MaxWidth"            Value="600"/>
        <Setter Property="CornerRadius"        Value="8"/>
        <Setter Property="Background"          Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground"          Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    
    <Style Selector="TextBox.UI:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrushPointerOver}"/>
    </Style>
    
    <Style Selector="TextBox.UI:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrushPointerOver}"/>
    </Style>
    
    <Style Selector="ComboBox.UI">
        <Setter Property="Margin"              Value="8"/>
        <Setter Property="CornerRadius"        Value="8"/>
        <Setter Property="Background"          Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="Foreground"          Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    
    <Style Selector="ComboBox.UI:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrushPointerOver}"/>
    </Style>

    <Style Selector="StackPanel.UICell">
        <Setter Property="Margin"              Value="5"/>
        <Setter Property="Spacing"             Value="7"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Orientation"         Value="Horizontal"/>
    </Style>

    <Style Selector="Border.SeparatorHorizontal">
        <Setter Property="Background"          Value="{DynamicResource SeparatorBrush}"/>
        <Setter Property="Height"              Value="1"/>
        <Setter Property="Margin"              Value="10,5"/>
    </Style>
    
    <Style Selector="Border.SeperatorVertical">
        <Setter Property="Background" Value="{DynamicResource SeparatorBrush}"/>
        <Setter Property="Width"      Value="1"/>
        <Setter Property="Margin"     Value="10,10,10,50"/>
    </Style>
    
    <Style Selector="GridSplitter.SeperatorVertical">
        <Setter Property="Background" Value="{DynamicResource SeparatorBrush}"/>
        <Setter Property="Width" Value="1"/>
        <Setter Property="Cursor" Value="SizeWestEast"/>
    </Style>

    <Style Selector="Border.CellInteractive">
        <Setter Property="Background"          Value="{DynamicResource SurfaceGradient}"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness"     Value="1"/>
        <Setter Property="Padding"             Value="10"/>
        <Setter Property="CornerRadius"        Value="8"/>
        <Setter Property="Margin"              Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Opacity" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Transitions">
            <Setter.Value>
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style Selector="MenuItem">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    
    <Style Selector="Border.CellInteractive:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceGradientPointerOver}"/>
        <Setter Property="Opacity" Value="0.8"/>
    </Style>
    
    <Style Selector="Border.SolidCard">
        <Setter Property="Background"          Value="{DynamicResource SolidCardBackgroundBrush}"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness"     Value="1"/>
        <Setter Property="Padding"             Value="10"/>
        <Setter Property="CornerRadius"        Value="8"/>
        <Setter Property="Margin"              Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    
    <Style Selector="Border.Cell">
        <Setter Property="Background"          Value="{DynamicResource SurfaceGradient}"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness"     Value="1"/>
        <Setter Property="Padding"             Value="10"/>
        <Setter Property="CornerRadius"        Value="8"/>
        <Setter Property="Margin"              Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    
    <Style Selector="TextBlock.UIHeader">
        <Setter Property="FontWeight"          Value="Bold"/>
        <Setter Property="FontSize"            Value="18"/>
        <Setter Property="Margin"              Value="15"/>
        <Setter Property="Foreground"          Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.UILabel">
        <Setter Property="FontWeight"          Value="SemiBold"/>
        <Setter Property="FontSize"            Value="16"/>
        <Setter Property="Margin"              Value="10"/>
        <Setter Property="Foreground"          Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.UIValue">
        <Setter Property="Margin"              Value="5"/>
        <Setter Property="Foreground"          Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="ListBox.SelectableItem">
        <Setter Property="Margin"              Value="5"/>
        <Setter Property="Padding"             Value="5"/>
        <Setter Property="CornerRadius"        Value="8"/>
        <Setter Property="Background"          Value="Transparent"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="CheckBox.IsPlayable">
        <Setter Property="Margin"                   Value="5"/>
        <Setter Property="HorizontalAlignment"      Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="IsEnabled"                Value="False"/>
    </Style>
    
    <Style Selector="ProgressBar:horizontal /template/ Border#ProgressBarTrack">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    
    <Style Selector="ProgressBar:horizontal /template/ Border#PART_Indicator">
        <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    
    <Style Selector="ProgressBar:horizontal /template/ Border#IndeterminateProgressBarIndicator">
        <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    
    <Style Selector="ProgressBar:horizontal /template/ Border#IndeterminateProgressBarIndicator2">
        <Setter Property="Background" Value="{DynamicResource AccentGradient}"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    
    <Style Selector="Slider:horizontal /template/ Thumb#thumb /template/ Ellipse#SliderInnerThumb">
        <Setter Property="Fill" Value="{DynamicResource AccentGradient}"/>
    </Style>
    
    <Style Selector="Slider:horizontal /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="{DynamicResource SliderIncrease}"/>
    </Style>
    
    
    <Style Selector="Slider:horizontal /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource SliderDecrease}"/>
    </Style>
    
    <Style Selector="Slider">
        <Setter Property="Margin" Value="5"/>
    </Style>
    
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox.spinRight /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    </Style>
    
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox.spinRight /template/ TextPresenter#PART_TextPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    
    <Style Selector="Grid.RootGrid">
        <Setter Property="Background" Value="{DynamicResource BackgroundGradient}"/>
    </Style>
    
    <Style Selector="StackPanel.RootPanel">
        <Setter Property="Background" Value="{DynamicResource BackgroundGradient}"/>
    </Style>
    
    <Style Selector="ScrollViewer.RootScrollViewer">
        <Setter Property="Background" Value="{DynamicResource BackgroundGradient}"/>
    </Style>
    
    <Style Selector="Image.Icon">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="5"/>
    </Style>
    
    <Style Selector="Slider.MediaPlayer">
        <Setter Property="Margin" Value="5"/>
        <Setter Property="Width" Value="400"/>
    </Style>
    
    <Style Selector="Button.TitleBarBtn">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Width"           Value="46"/>
        <Setter Property="Height"          Value="32"/>
        <Setter Property="CornerRadius"    Value="0"/>
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.TitleBarBtn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="rgba(255,255,255,0.1)"/>
    </Style>

    <Style Selector="Button.TitleBarClose:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#e81123"/>
    </Style>
    
    <Style Selector="Grid.LauncherContent">
        <Setter Property="Background"          Value="{DynamicResource BackgroundGradient}"/>
        <Setter Property="VerticalAlignment"   Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    
    <Style Selector="Image.LauncherLogo">
        <Setter Property="Width"               Value="64"/>
        <Setter Property="Height"              Value="64"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin"              Value="0,0,0,4"/>
    </Style>
    
    <Style Selector="TextBlock.LauncherTitle">
        <Setter Property="FontSize"            Value="24"/>
        <Setter Property="FontWeight"          Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground"          Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Margin"              Value="0,0,0,8"/>
    </Style>
    
    <Style Selector="TextBlock.LauncherStatus">
        <Setter Property="FontSize"            Value="13"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground"          Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Margin"              Value="5"/>
    </Style>
    
    <Style Selector="ScrollViewer.List">
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    
    <Style Selector="ProgressBar.LauncherProgress">
        <Setter Property="Height"              Value="4"/>
        <Setter Property="Margin"              Value="20,4"/>
    </Style>
    
    <Style Selector="Border.ErrorPanel">
        <Setter Property="Background"          Value="{DynamicResource ErrorPanelBrush}"/>
        <Setter Property="CornerRadius"        Value="8"/>
        <Setter Property="Padding"             Value="16,12"/>
        <Setter Property="Margin"              Value="0,4,0,0"/>
    </Style>
    
    <Style Selector="TextBlock.ErrorText">
        <Setter Property="FontSize"            Value="12"/>
        <Setter Property="TextWrapping"        Value="Wrap"/>
        <Setter Property="Foreground"          Value="{DynamicResource ErrorTextBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
        
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
            
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="BgPrimary">#0d1117</Color>
                    <Color x:Key="BgSecondary">#111827</Color>
                    <Color x:Key="Surface">#1e2a3a</Color>
                    <Color x:Key="BorderColor">#2d4a7a</Color>
                    <Color x:Key="Accent">#3776d4</Color>
                    <Color x:Key="AccentLight">#5a9ef5</Color>
                    <Color x:Key="TextPrimary">#e8edf5</Color>
                    <Color x:Key="TextSecondary">#7a8fa8</Color>
                    <Color x:Key="SliderIncrease">#a7dbef</Color>
                    <Color x:Key="SliderDecrease">#1a4d99</Color>
                    <Color x:Key="SurfacePointerOver">#253347</Color>
                    <Color x:Key="CardBackground">#0f1e33</Color>
                    <Color x:Key="ErrorPanel">#28FF4444</Color>
                    <Color x:Key="ErrorText">#FF6B6B</Color>

                    <SolidColorBrush x:Key="BgPrimaryBrush"         Color="{StaticResource BgPrimary}"/>
                    <SolidColorBrush x:Key="SurfaceBrush"            Color="{StaticResource Surface}"/>
                    <SolidColorBrush x:Key="BorderBrush"             Color="{StaticResource BorderColor}"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush"        Color="{StaticResource TextPrimary}"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush"      Color="{StaticResource TextSecondary}"/>
                    <SolidColorBrush x:Key="SliderIncreaseBrush"     Color="{StaticResource SliderIncrease}"/>
                    <SolidColorBrush x:Key="SliderDecreaseBrush"     Color="{StaticResource SliderDecrease}"/>
                    <SolidColorBrush x:Key="SurfaceBrushPointerOver" Color="{StaticResource SurfacePointerOver}"/>
                    <SolidColorBrush x:Key="SolidCardBackgroundBrush" Color="{StaticResource CardBackground}"/>
                    <SolidColorBrush x:Key="ErrorPanelBrush"         Color="{StaticResource ErrorPanel}"/>
                    <SolidColorBrush x:Key="ErrorTextBrush"          Color="{StaticResource ErrorText}"/>

                    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#2061c3" Offset="0"/>
                        <GradientStop Color="#0f3261" Offset="1"/>
                    </LinearGradientBrush>

                    <LinearGradientBrush x:Key="SeparatorBrush" StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#1a3a6a"     Offset="0.3"/>
                        <GradientStop Color="#3776d4"     Offset="0.5"/>
                        <GradientStop Color="#1a3a6a"     Offset="0.7"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>

                    <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="100%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#020408" Offset="0"/>
                        <GradientStop Color="#0a1f4a" Offset="1"/>
                    </LinearGradientBrush>

                    <LinearGradientBrush x:Key="SurfaceGradient" StartPoint="50%,0%" EndPoint="50%,100%">
                        <GradientStop Color="#0f2a5c" Offset="0"/>
                        <GradientStop Color="#060e1f" Offset="1"/>
                    </LinearGradientBrush>

                    <LinearGradientBrush x:Key="SurfaceGradientPointerOver" StartPoint="50%,0%" EndPoint="50%,100%">
                        <GradientStop Color="#1a3d75" Offset="0"/>
                        <GradientStop Color="#0a1a38" Offset="1"/>
                    </LinearGradientBrush>

                    <LinearGradientBrush x:Key="ListBackground" StartPoint="100%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#060d20" Offset="0"/>
                        <GradientStop Color="#0f2545" Offset="1"/>
                    </LinearGradientBrush>

                    <LinearGradientBrush x:Key="TitleBarGradient" StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="#020408" Offset="0"/>
                        <GradientStop Color="#0f2a5c" Offset="1"/>
                    </LinearGradientBrush>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <Color x:Key="BgPrimary">#f4f7fc</Color>
                    <Color x:Key="BgSecondary">#eaf0fa</Color>
                    <Color x:Key="Surface">#ddeaf8</Color>
                    <Color x:Key="BorderColor">#93b8e8</Color>
                    <Color x:Key="Accent">#1a5fba</Color>
                    <Color x:Key="AccentLight">#2e7ad4</Color>
                    <Color x:Key="TextPrimary">#0f1c2e</Color>
                    <Color x:Key="TextSecondary">#4a6080</Color>
                    <Color x:Key="SliderIncrease">#b8d4f0</Color>
                    <Color x:Key="SliderDecrease">#1a5fba</Color>
                    <Color x:Key="SurfacePointerOver">#c8ddf5</Color>
                    <Color x:Key="CardBackground">#ffffff</Color>
                    <Color x:Key="ErrorPanel">#30CC3333</Color>
                    <Color x:Key="ErrorText">#b91c1c</Color>

                    <SolidColorBrush x:Key="BgPrimaryBrush"         Color="{StaticResource BgPrimary}"/>
                    <SolidColorBrush x:Key="SurfaceBrush"            Color="{StaticResource Surface}"/>
                    <SolidColorBrush x:Key="BorderBrush"             Color="{StaticResource BorderColor}"/>
                    <SolidColorBrush x:Key="TextPrimaryBrush"        Color="{StaticResource TextPrimary}"/>
                    <SolidColorBrush x:Key="TextSecondaryBrush"      Color="{StaticResource TextSecondary}"/>
                    <SolidColorBrush x:Key="SliderIncreaseBrush"     Color="{StaticResource SliderIncrease}"/>
                    <SolidColorBrush x:Key="SliderDecreaseBrush"     Color="{StaticResource SliderDecrease}"/>
                    <SolidColorBrush x:Key="SurfaceBrushPointerOver" Color="{StaticResource SurfacePointerOver}"/>
                    <SolidColorBrush x:Key="SolidCardBackgroundBrush" Color="{StaticResource CardBackground}"/>
                    <SolidColorBrush x:Key="ErrorPanelBrush"         Color="{StaticResource ErrorPanel}"/>
                    <SolidColorBrush x:Key="ErrorTextBrush"          Color="{StaticResource ErrorText}"/>

                    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#1a5fba" Offset="0"/>
                        <GradientStop Color="#0d3d80" Offset="1"/>
                    </LinearGradientBrush>

                    <LinearGradientBrush x:Key="SeparatorBrush" StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="#93b8e8"     Offset="0.3"/>
                        <GradientStop Color="#1a5fba"     Offset="0.5"/>
                        <GradientStop Color="#93b8e8"     Offset="0.7"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>

                    <LinearGradientBrush x:Key="BackgroundGradient" StartPoint="100%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#ffffff" Offset="0"/>
                        <GradientStop Color="#a8ccf0" Offset="1"/>
                    </LinearGradientBrush>

                    <LinearGradientBrush x:Key="SurfaceGradient" StartPoint="50%,0%" EndPoint="50%,100%">
                        <GradientStop Color="#e8f3fd" Offset="0"/>
                        <GradientStop Color="#93bce8" Offset="1"/>
                    </LinearGradientBrush>

                    <LinearGradientBrush x:Key="SurfaceGradientPointerOver" StartPoint="50%,0%" EndPoint="50%,100%">
                        <GradientStop Color="#d4e8f8" Offset="0"/>
                        <GradientStop Color="#7aaee0" Offset="1"/>
                    </LinearGradientBrush>

                    <LinearGradientBrush x:Key="ListBackground" StartPoint="100%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#f0f7ff" Offset="0"/>
                        <GradientStop Color="#b8d8f5" Offset="1"/>
                    </LinearGradientBrush>

                    <LinearGradientBrush x:Key="TitleBarGradient" StartPoint="0%,50%" EndPoint="100%,50%">
                        <GradientStop Color="#ffffff" Offset="0"/>
                        <GradientStop Color="#a8ccf0" Offset="1"/>
                    </LinearGradientBrush>
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>
    
</Styles>