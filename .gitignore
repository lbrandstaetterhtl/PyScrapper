# ==============================================================================
# PyScrapper - Multi-Language Project .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project-Specific Files & Directories
# ------------------------------------------------------------------------------
# Ignore all downloaded content and specific output folders
/Downloads/
/PythonModule/Downloads/
/LocalServer/logs/
/PyScrapperDesktopApp/Downloads/
cookies.txt
*.log

# ------------------------------------------------------------------------------
# 2. Python (LocalServer, PythonModule)
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
.env/
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------------------------
# 3. .NET / C# (PyScrapperDesktopApp, PyScrapperDesktopApp.Tests)
# ------------------------------------------------------------------------------
bin/
obj/
[Bb]in/
[Oo]bj/
[Oo]ut/
TestResults/
*.suo
*.user
*.userosscache
*.sln.docstates
*.dll
*.exe
*.pdb

# ------------------------------------------------------------------------------
# 4. Node.js / Frontend (PyScrapperWebInterface)
# ------------------------------------------------------------------------------
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependencies
node_modules/
jspm_packages/

# Production builds
dist/
dist-ssr/
build/
out/

# Vite
.vite/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ------------------------------------------------------------------------------
# 5. IDEs and Editors
# ------------------------------------------------------------------------------
# JetBrains Rider / IntelliJ
.idea/
*.sln.iml
*.orig

# Visual Studio Code
.vscode/

# Visual Studio
.vs/

# Mac / Windows system files
.DS_Store
Thumbs.db
Desktop.ini
